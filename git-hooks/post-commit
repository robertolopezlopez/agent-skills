#!/usr/bin/env bash
set -euo pipefail

# Git runs hooks with the working tree as cwd; resolve repo root reliably when this path is a symlink.
repo_root="$(git rev-parse --show-toplevel)"

# Install skills for both Codex and Cursor on each commit (do not inherit a narrowed AGENT_SKILLS_SYNC_TARGETS from the user's shell).
env AGENT_SKILLS_SYNC_TARGETS=codex,cursor,opencode "$repo_root/scripts/sync_skills.sh" --all

# Refresh Cursor always-on rules from templates/cursor/rules/ (skip when ~/.cursor is absent).
"$repo_root/scripts/sync_cursor_rules.sh" --overwrite

# Refresh managed Codex rules in the global AGENTS.md (skip when ~/.codex is absent).
"$repo_root/scripts/sync_codex_rules.sh" --overwrite

# Refresh managed OpenCode rules in the global AGENTS.md (skip when OpenCode config home is absent).
"$repo_root/scripts/sync_opencode_rules.sh" --overwrite
