#!/usr/bin/env bash
set -euo pipefail

# Git runs hooks with the working tree as cwd; resolve repo root reliably when this path is a symlink.
repo_root="$(git rev-parse --show-toplevel)"

# Install skills into the targets named by AGENT_SKILLS_SYNC_TARGETS; the default keeps every install root in sync.
targets="${AGENT_SKILLS_SYNC_TARGETS:-codex,cursor,opencode}"
AGENT_SKILLS_SYNC_TARGETS="$targets" "$repo_root/scripts/sync_skills.sh" --all

# Refresh Cursor always-on rules from templates/cursor/rules/ (skip when the target is not selected or ~/.cursor is absent).
case ",$targets," in
  *,cursor,*) "$repo_root/scripts/sync_cursor_rules.sh" --overwrite ;;
esac

# Refresh managed Codex rules in the global AGENTS.md (skip when the target is not selected or ~/.codex is absent).
case ",$targets," in
  *,codex,*) "$repo_root/scripts/sync_codex_rules.sh" --overwrite ;;
esac

# Refresh managed OpenCode rules in the global AGENTS.md (skip when the target is not selected or OpenCode config home is absent).
case ",$targets," in
  *,opencode,*) "$repo_root/scripts/sync_opencode_rules.sh" --overwrite ;;
esac
