# Atlassian Cloud defaults for Cursor/Codex jira & confluence skills.
#
# 1) Resolve install path:
#      python3 ~/.cursor/skills/scripts/agent_config.py --atlassian-env
# 2) Copy this file to that path and edit locally (do not commit secrets).
# 3) Run: ~/.cursor/skills/scripts/check_skill_config.sh jira
#
# Helpers load URLs and ATLASSIAN_API_TOKEN from this file when not exported.
# REST helpers (jira-request, jira-api) use Basic auth: email must match the token owner.
# Prefer ATLASSIAN_AUTH_EMAIL when it differs from git config user.email; otherwise set git email.
# Primary Jira and Confluence transports use acli; these credentials are REST-helper fallback only.
# API token: https://id.atlassian.com/manage-profile/security/api-tokens

ATLASSIAN_API_BASE_URL=https://example.atlassian.net
# REST fallback email (optional when git config user.email matches the token owner):
# ATLASSIAN_AUTH_EMAIL=you@company.com
# Optional explicit Confluence REST v2 root:
# ATLASSIAN_CONFLUENCE_API_BASE_URL=https://example.atlassian.net/wiki/rest/api/v2

# Optional when not exported in the shell and not using ~/.config/.jira/.credentials:
# ATLASSIAN_API_TOKEN=your-api-token
